root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# Braces
csharp_new_line_before_open_brace = all

# ❌ Disable parameter wrapping
csharp_wrap_parameters = false
csharp_wrap_method_parameters = false
csharp_wrap_constructor_parameters = false
csharp_wrap_record_parameters = false

# Keep usings tight
dotnet_separate_import_directive_groups = false


[*.json]
indent_size = 2

[*.yml]
indent_size = 2
