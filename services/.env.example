# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ── Docker compose vars (VideoWorker + generation container) ───────────────────
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SocialMediaDb?retryWrites=true&w=majority
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=social-media-assets
VIDEO_GENERATOR_TYPE=WanGP
WORKER_ID=worker-vm-01
WANGP_COMMIT=main

# ── SocialMediaAPI (ASP.NET Core reads these via DotNetEnv) ───────────────────
MongoDb__ConnectionString=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SocialMediaDb?retryWrites=true&w=majority
MongoDb__DatabaseName=SocialMediaDb
CloudflareR2__AccountId=
CloudflareR2__AccessKey=
CloudflareR2__SecretKey=
CloudflareR2__BucketName=social-media-assets
Encryption__Key=
YouTube__ClientId=
YouTube__ClientSecret=
YouTube__RedirectUri=http://<vm-ip>:5000/api/oauth/callback
