{
  "runtime": "Net80",
  "documentGenerator": {
    "fromDocument": { "url": "https://localhost:65027/swagger/v1/swagger.json" }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "template": "Angular",
      "httpClass": "HttpClient",
      "stringEnums": true,
      "generateClientInterfaces": true,
      "generateOptionalParameters": true,
      "useAbortSignal": true,
      "rxJsVersion": 7,
      "injectionTokenType": "InjectionToken",
      "providedIn": "root",
      "baseUrl": "https://localhost:65027",
      "output": "libs/core/clients/sports-api.client.ts"
    }
  }
}
